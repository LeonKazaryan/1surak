# LLM through any OpenAI-compatible API. Leave the key empty to run with the built-in stub reply.
# OPENAI_API_KEY also works in place of LLM_API_KEY.
LLM_BASE_URL=
LLM_API_KEY=
LLM_MODEL=
LLM_TIMEOUT_S=60

# Examples:
# LLM_BASE_URL=https://openrouter.ai/api/v1
# LLM_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai/

# Web search for the agent's knowledge base. Tavily works without a key (rate-limited);
# a free key (1,000 searches/month) raises the limit. SEARCH_PROVIDER=none turns web search off.
SEARCH_PROVIDER=tavily
TAVILY_API_KEY=
SEARCH_TIMEOUT_S=10
