# LLM through any OpenAI-compatible API. Leave the key empty to run with the built-in stub reply.
# OPENAI_API_KEY also works in place of LLM_API_KEY.
LLM_BASE_URL=
LLM_API_KEY=
LLM_MODEL=
LLM_TIMEOUT_S=60
# Chat turns and price refreshes one client may start a minute (each turn spends LLM credits). 0 turns it off.
RATE_LIMIT_PER_MINUTE=20
# OpenAI only: how long the model thinks before it answers (none, low, medium, high, xhigh, max).
# Empty leaves the model's default, medium for gpt-6-luna.
LLM_REASONING_EFFORT=

# Examples:
# LLM_BASE_URL=   (empty means OpenAI)   with LLM_MODEL=gpt-6-luna and LLM_REASONING_EFFORT=low
# LLM_BASE_URL=https://api.x.ai/v1   with LLM_MODEL=grok-4.7
# LLM_BASE_URL=https://openrouter.ai/api/v1
# LLM_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai/

# Web search for the agent's knowledge base. auto: Brave first when BRAVE_API_KEY is set, then Tavily,
# then OpenAI web search. Tavily works without a key (rate-limited); a free key (1,000 searches/month)
# raises the limit. Brave: $5 per 1,000 searches with $5 free credit a month. none turns web search off.
SEARCH_PROVIDER=auto
BRAVE_API_KEY=
TAVILY_API_KEY=
SEARCH_TIMEOUT_S=10

# read_page: the agent opens one page and pulls out facts with exact quotes. Pages built by JavaScript go
# through Jina Reader (20 pages/min without a key). EXTRACT_MODEL defaults to LLM_MODEL.
JINA_API_KEY=
EXTRACT_MODEL=
PAGE_TIMEOUT_S=12

# Real flight prices from Aviasales (Travelpayouts Data API). Free token: travelpayouts.com → profile → API token.
# Without it the agent has no flights and says so.
TRAVELPAYOUTS_TOKEN=

# Trains and buses between the cities of a route: Tutu.ru trains and FlixBus need no key (FLIXBUS=false turns
# the unofficial FlixBus API off). Yandex.Rasp adds rides on the day and buses in Russia: a free key at
# developer.tech.yandex.ru («API Яндекс.Расписаний»); its data is shown with the credit its terms require.
YANDEX_RASP_KEY=

# The knowledge base is searched by words and by meaning (a local multilingual model, no key).
# EMBEDDINGS=false keeps word search only.
EMBEDDINGS=true

# PostgreSQL with pgvector. docker compose sets DATABASE_URL for the app itself; these only change
# the credentials and the port the database listens on at 127.0.0.1 for local development.
# POSTGRES_USER=onesurak
# POSTGRES_PASSWORD=onesurak
# POSTGRES_DB=onesurak
# POSTGRES_PORT=5433
