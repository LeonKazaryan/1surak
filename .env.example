# LLM through any OpenAI-compatible API. Leave the key empty to run with the built-in stub reply.
# OPENAI_API_KEY also works in place of LLM_API_KEY.
LLM_BASE_URL=
LLM_API_KEY=
LLM_MODEL=
LLM_TIMEOUT_S=60

# Examples:
# LLM_BASE_URL=https://api.x.ai/v1   with LLM_MODEL=grok-4.7
# LLM_BASE_URL=https://openrouter.ai/api/v1
# LLM_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai/

# Web search for the agent's knowledge base. auto: Brave first when BRAVE_API_KEY is set, then Tavily,
# then OpenAI web search. Tavily works without a key (rate-limited); a free key (1,000 searches/month)
# raises the limit. Brave: $5 per 1,000 searches with $5 free credit a month. none turns web search off.
SEARCH_PROVIDER=auto
BRAVE_API_KEY=
TAVILY_API_KEY=
SEARCH_TIMEOUT_S=10

# read_page: the agent opens one page and pulls out facts with exact quotes. Pages built by JavaScript go
# through Jina Reader (20 pages/min without a key). EXTRACT_MODEL defaults to LLM_MODEL.
JINA_API_KEY=
EXTRACT_MODEL=
PAGE_TIMEOUT_S=12

# Real flight prices from Aviasales (Travelpayouts Data API). Free token: travelpayouts.com → profile → API token.
# Without it the agent has no flights and says so.
TRAVELPAYOUTS_TOKEN=
